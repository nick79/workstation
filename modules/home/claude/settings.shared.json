{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(trash *)",
      "Bash(git clean *)",
      "Bash(find * -delete*)"
    ],
    "deny": [
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(security export *)",
      "Bash(/usr/bin/security find-generic-password *)",
      "Bash(/usr/bin/security find-internet-password *)",
      "Bash(/usr/bin/security dump-keychain *)",
      "Bash(/usr/bin/security export *)",
      "Bash(gh auth token*)",
      "Bash(git credential fill*)",
      "Bash(git credential-osxkeychain *)"
    ]
  }
}
